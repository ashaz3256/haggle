# LLM provider for the agents. Pick ONE:
#
# (a) Any OpenAI-compatible endpoint (Gemini free tier shown; also works with OpenAI, Groq, Ollama, …)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
# Optional: comma-separated models to try if the main one is overloaded (429/5xx)
LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1          LLM_MODEL=google/gemini-2.5-flash
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1             LLM_MODEL=gpt-4o-mini
#
# (b) Anthropic directly — set this and leave LLM_* unset
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# PayPal sandbox — developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

DATABASE_URL="file:./dev.db"

# Optional demo access gate for a public instance. Unset = open. Visitors enter it at /gate or via ?code=... on any URL.
ACCESS_CODE=
# Max negotiations one IP may start per hour (default 12).
NEG_RATE_LIMIT=12
