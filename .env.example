# ── Agent model: pick ONE provider ──────────────────────────────
# Option A: Anthropic Claude (best negotiation quality)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Option B: any OpenAI-compatible API. Gemini has a free tier (aistudio.google.com → Get API key)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1          LLM_MODEL=google/gemini-2.5-flash
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1             LLM_MODEL=gpt-4o-mini

# PayPal sandbox — developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

DATABASE_URL="file:./dev.db"
